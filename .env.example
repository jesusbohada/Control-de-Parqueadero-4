# Plantilla de variables de entorno para despliegue
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5433/wolfzonepos_db
DISABLE_HMR=true

# --- Seguridad (Fase 1) ---
# Secreto para firmar sesiones (≥32 caracteres). Si se omite, se genera en data/.session_secret
SESSION_SECRET=
# Clave compartida entre el Central y TODAS las sucursales (≥16 caracteres, la misma en todos).
# Sin ella, /api/sync/* queda en modo compatible (abierto) y el SSO Central→Sucursal se deshabilita.
SYNC_SHARED_KEY=

# --- Sincronización servidor↔servidor (Fase 3) — solo en SUCURSALES ---
# Dirección del Servidor Central. El servidor de la sucursal trae de allí los usuarios
# (con sus claves en hash) usando SYNC_SHARED_KEY, sin pasar por el navegador.
CENTRAL_SERVER_URL=
# Minutos entre sincronizaciones (1–60, por defecto 5)
CENTRAL_SYNC_INTERVAL_MIN=5
